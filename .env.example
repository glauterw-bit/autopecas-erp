# Banco de dados
DATABASE_URL="postgresql://user:password@localhost:5432/autopecas_erp"

# Auth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="troque-este-segredo"

# OpenAI (IA Vision, OCR NF-e, predição de demanda, chat com tool-use)
OPENAI_API_KEY="sk-..."
# Modelos por papel (vazio = padrão de src/lib/ai/client.ts).
# gpt-4o e gpt-4o-mini desligam em 14/01/2027 (developers.openai.com/api/docs/deprecations).
OPENAI_MODEL_REASONING=""   # padrão gpt-6.1-terra
OPENAI_MODEL_DEFAULT=""     # padrão gpt-6.1-terra (OCR de DANFE, foto da peça, SmartCross)
OPENAI_MODEL_FAST=""        # padrão gpt-6-luna (explicações curtas)
OPENAI_MODEL_TOOLS=""       # padrão gpt-6-luna (chat com ferramentas; precisa aceitar function calling no Chat Completions)
# Esforço de raciocínio opcional por papel: none|low|medium|high|xhigh|max (ex.: OPENAI_MODEL_DEFAULT_ESFORCO="low")
# Teto mensal de gasto com IA por loja, em US$ (0 desliga a IA). Por loja: Empresa.configuracoes.iaTetoMensalUsd
IA_TETO_MENSAL_USD="20"
# Empresa que atende o WHATSAPP_PHONE_NUMBER_ID quando há um só número (sem MarketplaceConta WHATSAPP_CATALOG)
WHATSAPP_EMPRESA_ID=""

# Mercado Livre
ML_APP_ID=""
ML_CLIENT_SECRET=""
ML_REDIRECT_URI="http://localhost:3000/api/marketplaces/ml/callback"
ML_STATE_SECRET=""            # 16+ caracteres; assina o state do OAuth do ML (se vazio usa NEXTAUTH_SECRET)

# Shopee
SHOPEE_PARTNER_ID=""
SHOPEE_PARTNER_KEY=""

# Amazon SP-API
AMAZON_LWA_CLIENT_ID=""
AMAZON_LWA_CLIENT_SECRET=""
AMAZON_REFRESH_TOKEN=""

# WhatsApp Business Cloud API
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN=""

# Emissor NF-e (Focus NFe / WebmaniaBR)
FOCUS_NFE_TOKEN=""
FOCUS_NFE_AMBIENTE="homologacao"
# Gatilho da Focus (POST /api/webhooks/focus-nfe): mesmo valor no campo "authorization" do hook
FOCUS_WEBHOOK_TOKEN=""
FOCUS_WEBHOOK_HEADER="Authorization"

# Consulta de placa (chave vai só no header; nunca na URL)
PLACA_API_KEY=""             # consultadeplaca.net (Authorization: Bearer)
PLACA_WDAPI_TOKEN=""         # reserva opcional (WDAPI põe o token na URL; deixe vazio se não usar)

# TecDoc (catálogo de aplicação veicular)
TECDOC_PROVIDER_ID=""
TECDOC_API_KEY=""

# Redis (filas de sincronização marketplace)
REDIS_URL="redis://localhost:6379"

# Storage de imagens (S3 compatível)
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET="autopecas-media"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# Segurança (obrigatórios em produção)
SESSION_SECRET=""            # >= 32 chars — assina cookies B2B
WEBHOOK_TOKEN=""             # token secreto da URL dos webhooks de marketplace
META_APP_SECRET=""           # App Secret da Meta — valida X-Hub-Signature-256 do WhatsApp

# URL pública do app (usada na config da integração Vallente)
APP_URL="https://autopecas-app-production.up.railway.app"

# Redis (workers BullMQ + webhooks enfileirados)
REDIS_URL="redis://localhost:6379"

# Pix via PSP (mTLS obrigatório pelo BCB) — ver src/lib/pagamentos/psp-pix.ts
PSP_PIX_PROVEDOR=""          # efi | inter | sicoob | bb | generico
PSP_PIX_BASE_URL=""
PSP_PIX_CLIENT_ID=""
PSP_PIX_CLIENT_SECRET=""
PSP_PIX_TOKEN_URL=""         # opcional: sobrescreve a URL de token padrão do PSP
PSP_PIX_SCOPE=""
PSP_PIX_CERT_P12_BASE64=""   # certificado .p12 em base64 (Efí) — ou o par abaixo
PSP_PIX_CERT_PEM_BASE64=""   # .crt em base64 (Inter/Sicoob/BB)
PSP_PIX_KEY_PEM_BASE64=""    # .key em base64
PSP_PIX_CERT_SENHA=""        # senha do .p12, se houver
PSP_PIX_BB_APP_KEY=""        # só BB
# Webhook Pix
PIX_WEBHOOK_SECRET=""        # segredo da URL (?hmac=...); sem ele cai no WEBHOOK_TOKEN
PIX_WEBHOOK_IPS=""           # IPs do PSP, separados por vírgula (opcional)
PIX_WEBHOOK_MTLS_PROXY=""    # 1 = exigir mTLS validado por proxy na borda
PIX_WEBHOOK_PROXY_SECRET=""
PIX_WEBHOOK_CERT_FINGERPRINTS=""

# Mercado Livre — compatibilidades (padrão: carros e vans)
ML_DOMINIO_COMPAT="MLB-CARS_AND_VANS_FOR_COMPATIBILITIES"

# Backup (scripts/backup-postgres.sh; usa também S3_*)
BACKUP_RETENCAO_DIAS="14"
BACKUP_S3_PASTA="backups/postgres"

# E-mail de recuperação de senha (opcional; sem isso o ADMIN gera o link em Configurações → Usuários)
RESEND_API_KEY=""
EMAIL_FROM=""                # ex.: "AutoPeças <nao-responda@suaempresa.com.br>"
